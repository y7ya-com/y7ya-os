[Desktop Entry]
Type=Application
Name=Assistant
GenericName=Settings
Comment=Change system settings by asking in plain language
Exec=assistant
Icon=y7ya-assistant
Terminal=false
Categories=Settings;System;
Keywords=settings;preferences;control;dark mode;volume;wifi;bluetooth;display;
StartupWMClass=assistant
Actions=Quick;

[Desktop Action Quick]
Name=Quick Ask
Exec=assistant --quick
